{
  "id": "lfCampaignTask01",
  "name": "LoopForge - Bounded Review Unit",
  "active": false,
  "nodes": [
    {
      "id": "when-called",
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "unit-identity",
      "name": "Unit Identity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const c=$input.first().json;\nif (!/^campaign_[a-f0-9]{12}$/.test(c.campaignId)) throw new Error('Invalid campaign identity');\nif(c.baseUrl !== 'http://host.docker.internal:8124') throw new Error('Unexpected harness endpoint');\nreturn [{json:{campaignId:c.campaignId,baseUrl:c.baseUrl,unitKey:c.unitKey,dispatchKey:c.dispatchKey || (\"n8n:\"+$execution.id)}}];"
      }
    },
    {
      "id": "claim-or-reconnect",
      "name": "Claim Or Reconnect",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Unit Identity').first().json.baseUrl + '/campaigns/' + $('Unit Identity').first().json.campaignId + '/tick' }}",
        "options": {
          "timeout": 20000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {dispatch_key: $(\"Unit Identity\").first().json.dispatchKey,unit_key:$(\"Unit Identity\").first().json.unitKey} }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "wait-for-agent",
      "name": "Wait For Agent",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        660,
        0
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 5,
        "unit": "seconds"
      }
    },
    {
      "id": "read-unit-state",
      "name": "Read Unit State",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "url": "={{ $('Unit Identity').first().json.baseUrl + '/campaigns/' + $('Unit Identity').first().json.campaignId + '/checkpoint' }}",
        "options": {
          "timeout": 20000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "still-running",
      "name": "Still Running",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "status",
              "leftValue": "={{ $json.state.status === 'running' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "return-checkpoint",
      "name": "Return Checkpoint",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1320,
        200
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "When Called": {
      "main": [
        [
          {
            "node": "Unit Identity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Unit Identity": {
      "main": [
        [
          {
            "node": "Claim Or Reconnect",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim Or Reconnect": {
      "main": [
        [
          {
            "node": "Wait For Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait For Agent": {
      "main": [
        [
          {
            "node": "Read Unit State",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Unit State": {
      "main": [
        [
          {
            "node": "Still Running",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Still Running": {
      "main": [
        [
          {
            "node": "Wait For Agent",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Return Checkpoint",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": false,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "executionTimeout": 18000
  },
  "pinData": {}
}
