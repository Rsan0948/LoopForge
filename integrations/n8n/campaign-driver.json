{
  "id": "lfCampaignMain01",
  "name": "LoopForge - Sequential Repository Campaign",
  "active": false,
  "nodes": [
    {
      "id": "manual-start",
      "name": "Manual Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "campaign-config",
      "name": "Campaign Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const campaignId = ''; // Set to the ID returned by POST /campaigns.\nif (!/^campaign_[a-f0-9]{12}$/.test(campaignId)) throw new Error('Set campaignId before starting this campaign');\nreturn [{json:{campaignId,baseUrl:'http://host.docker.internal:8124',batchStartedAt:Date.now()}}];"
      }
    },
    {
      "id": "read-checkpoint",
      "name": "Read Checkpoint",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "url": "={{ $('Campaign Config').first().json.baseUrl + '/campaigns/' + $('Campaign Config').first().json.campaignId + '/checkpoint' }}",
        "options": {
          "timeout": 20000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "ready-for-next-unit",
      "name": "Ready For Next Unit",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "status",
              "leftValue": "={{ $json.runnable === true && $runIndex < 12 && Date.now() - $('Campaign Config').first().json.batchStartedAt < 1800000 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "unit-config",
      "name": "Unit Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        770,
        0
      ],
      "parameters": {
        "jsCode": "const c=$('Campaign Config').first().json; return [{json:{...c,unitKey:$input.first().json.unit_key,dispatchKey:(c.launchId || $execution.id)+':'+$input.first().json.unit_key}}];"
      }
    },
    {
      "id": "run-bounded-unit",
      "name": "Run Bounded Unit",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "lfCampaignTask01",
          "mode": "id"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "between-units",
      "name": "Between Units",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 1,
        "unit": "seconds"
      }
    },
    {
      "id": "campaign-checkpoint",
      "name": "Campaign Checkpoint",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        880,
        200
      ],
      "parameters": {}
    },
    {
      "id": "continue-ready-batch",
      "name": "Continue Ready Batch",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "continue",
              "leftValue": "={{ $json.runnable === true && Boolean($('Campaign Config').first().json.continuationUrl) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "continue-batch",
      "name": "Continue Batch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Campaign Config').first().json.continuationUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {campaignId:$('Campaign Config').first().json.campaignId,launchId:$('Campaign Config').first().json.launchId} }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      }
    }
  ],
  "connections": {
    "Manual Start": {
      "main": [
        [
          {
            "node": "Campaign Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Campaign Config": {
      "main": [
        [
          {
            "node": "Read Checkpoint",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Checkpoint": {
      "main": [
        [
          {
            "node": "Ready For Next Unit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ready For Next Unit": {
      "main": [
        [
          {
            "node": "Unit Config",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Campaign Checkpoint",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Unit Config": {
      "main": [
        [
          {
            "node": "Run Bounded Unit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Bounded Unit": {
      "main": [
        [
          {
            "node": "Between Units",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Between Units": {
      "main": [
        [
          {
            "node": "Read Checkpoint",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Campaign Checkpoint": {
      "main": [
        [
          {
            "node": "Continue Ready Batch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Continue Ready Batch": {
      "main": [
        [
          {
            "node": "Continue Batch",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": false,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "executionTimeout": 21600
  },
  "pinData": {}
}
